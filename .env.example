# Database Configuration
DATABASE_JNDI=jdbc:postgresql://localhost:5432/grimoire
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Local Storage Path
LOCAL_STORAGE=C:\temp\GRIM

# Yandex Translate API key (from console.cloud.yandex.com)
YANDEX_API_KEY=your_yandex_api_key

# Server Port (optional, defaults to 8081 in application.properties)
# PORT=8081
